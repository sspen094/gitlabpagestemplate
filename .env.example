# Public URL path for this site (Vite `base`). No secrets.
#
# Local / user site (https://<user>.github.io/):
#   BASE_URL=/
#
# Project site (https://<user>.github.io/<repo>/):
#   BASE_URL=/<repo>/
#
# Copy this file to `.env.local` (gitignored) and set the value for your fork.

BASE_URL=/

# One PUBLIC, read-only Google Spreadsheet share URL for all updatable modules.
# Each worksheet tab must match its target parent module id (for example,
# demo-calendar). Never use an edit credential or private sheet. Leave unset to
# render the static shell.
#
VITE_GOOGLE_SHEETS_URL=

# Worksheet ids, as `<tab>:<gid>` pairs. Open a tab in the spreadsheet and copy
# the `#gid=` number from the address bar. A tab listed here is read exactly as
# typed; a tab left out keeps its static shell. Tabs used by this template:
# demo-text, demo-cards, demo-calendar, contact-info.
#
VITE_GOOGLE_SHEETS_GIDS=demo-text:0,demo-cards:,demo-calendar:,contact-info:

# Public form endpoints only. Never put provider API secrets here.
# Email-service adapter POSTs fields to this https URL (Formspree, Getform,
# Web3Forms, or similar). Leave empty until a provider endpoint is chosen.
#
VITE_SUBMIT_EMAIL_ENDPOINT=

# Public destination used by the local `mailto:` fallback. If no endpoint is
# set, submitting opens the visitor's default mail app. Leave empty to let the
# visitor choose a recipient in that app.
#
VITE_SUBMIT_EMAIL_RECIPIENT=

# Subject and body used by the local mail-app fallback. Supported placeholders:
# {name}, {email}, and {message}. Use \n for a line break. Quote values that
# contain spaces.
#
VITE_SUBMIT_EMAIL_SUBJECT="Website contact from {name}"
VITE_SUBMIT_EMAIL_BODY_TEMPLATE="Dear Website Owner:\n{message}\nFrom {name} ({email})"

# Redirect/handoff adapter sends the visitor to this https hosted form or
# workflow URL. Leave empty if the site uses the email-service adapter instead.
#
VITE_SUBMIT_REDIRECT_URL=


# =============================================================================
# DEPLOYED CONFIG — DEV (mfgcidashboard)
# Committed in git. Copied to .env.local on the DEV host by Install-ProjectEnv.ps1.
#
# AFTER EVERY git pull ON THE SERVER:
#   .\deployments\scripts\Install-ProjectEnv.ps1 -Environment dev
#   # Then restart app per org-deployment-profile.md (e.g. IIS app pool recycle)
#
# FILL: hostnames, SQL service account, public URL, integration flags.
# LOCAL LAPTOP: do not use this file directly — use .env.example → .env.local
#   (copy SQL block from deployments/env/local-dev-sql.env.example).
#
# See: deployments/env/README.md · deployments/DEPLOY.md · docs/developer.md §7
# =============================================================================

APP_ENV=dev
APP_NAME=MFGCIDashboard

# --- SQL (FILL — DEV host → DEV SQL) ---
# Service account for the runtime host (not your personal login).
APP_DB_HOST=SRVIRQSQLDEV
APP_DB_PORT=1433
APP_DB_DOMAIN=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_NAME=CIDashboard

# --- App URLs (FILL when HTTP UI or API is public) ---
APP_SERVER_DEV_PUBLIC_URL=http://SRVIRQETLDEV:8080
APP_DB_URL=
WAREHOUSE_DB_URL=

# --- File storage (FILL if app stores uploads on server) ---
# APP_ATTACHMENT_ROOT=/var/mfgcidashboard/data/attachments

# --- Navigation (optional — when app has a menu) ---
# Comma-separated menu keys to hide; prefer editing deployments/env/nav-visibility.txt
# APP_NAV_DISABLED=

# --- ClickUp (OPTIONAL — remove block if project does not use ClickUp) ---
# CLICKUP_API_TOKEN=
# CLICKUP_WORKSPACE_ID=
# CLICKUP_BUG_LIST_ID=
# CLICKUP_BUG_LIST_NAME=
# CLICKUP_POLL_ENABLED=false
# CLICKUP_POLL_INTERVAL_SECONDS=300

# --- Other integrations (OPTIONAL) ---
# OPENAI_API_KEY=
# LDAP_HOST=

# --- Background jobs / Health page (FILL per integration you ship) ---
# Pattern: <NAME>_POLL_ENABLED=true|false  <NAME>_POLL_INTERVAL_SECONDS=300
# DEV: enable only what you need for testing; disable heavy writes by default.

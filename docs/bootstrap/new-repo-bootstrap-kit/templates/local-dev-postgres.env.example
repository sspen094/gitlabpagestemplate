# =============================================================================
# LOCAL DEVELOPMENT — PostgreSQL (copy into .env.local)
#
# Use when you do NOT run Microsoft SQL Server locally but want a server DB
# (Docker, Homebrew, or native Postgres). Closer semantics to shared DEV than SQLite.
#
# Install driver: pip install -e ".[dev,local-postgres]"
#
# Example Docker:
#   docker run -d --name mfgcidashboard-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=mfgcidashboard_local -p 5432:5432 postgres:16
#
# Caveat: DDL under databases/CIDashboard/ targets SQL Server — use migrations or
# adapt locally; validate T-SQL on DEV SQL Server before merge.
# =============================================================================

APP_DB_ENGINE=postgresql
APP_DB_URL=postgresql+psycopg://postgres:dev@127.0.0.1:5432/mfgcidashboard_local

# Clear SQL Server vars when using PostgreSQL locally:
APP_DB_HOST=
APP_DB_PORT=
APP_DB_DOMAIN=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_NAME=

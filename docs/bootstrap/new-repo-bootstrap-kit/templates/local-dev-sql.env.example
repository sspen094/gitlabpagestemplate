# =============================================================================
# LOCAL DEVELOPER → DEV SQL (copy into .env.local)
#
# Use when YOUR laptop connects to the shared DEV SQL server.
# Web servers use the service account in deployments/env/mfgcidashboard.dev.env instead.
#
# Steps:
#   1. Copy the variables below into .env.local (replace placeholders)
#   2. set -a && source .env.local && set +a
#   3. python tests/integration/database/verify_db_connection.py  (if present)
# =============================================================================

APP_DB_HOST=SRVIRQSQLDEV
APP_DB_PORT=1433
APP_DB_DOMAIN=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_NAME=CIDashboard

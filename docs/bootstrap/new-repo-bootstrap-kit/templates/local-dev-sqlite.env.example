# =============================================================================
# LOCAL DEVELOPMENT — SQLite (copy into .env.local)
#
# Use when you do NOT run Microsoft SQL Server on your laptop.
# Recommended default for local-only dev — no server install required.
#
# Caveat: DDL under databases/CIDashboard/ is authored for SQL Server (deployed).
# Use SQLite for app development; validate against SQL Server in CI or DEV tier.
#
# Steps:
#   1. Copy the variables below into .env.local
#   2. mkdir -p data   (gitignored — add data/ to .gitignore if missing)
#   3. pip install -e ".[dev]"   (no extra driver needed for SQLite)
#   4. set -a && source .env.local && set +a
# =============================================================================

APP_DB_ENGINE=sqlite
APP_DB_URL=sqlite:///./data/mfgcidashboard_local.db

# Clear SQL Server vars when using SQLite locally:
APP_DB_HOST=
APP_DB_DOMAIN=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_NAME=

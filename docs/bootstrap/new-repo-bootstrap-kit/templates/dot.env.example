# =============================================================================
# LOCAL DEVELOPMENT — copy this file to .env.local and fill in values.
# .env.local is gitignored. This file is safe to commit.
#
# HOW TO USE:
#   cp .env.example .env.local
#   # Edit .env.local — required blocks marked FILL below
#   set -a && source .env.local && set +a
#   python -m mfgcidashboard_app.api_main    # or entrypoint per vision
#
# SERVER DEPLOY (DEV/TST/PRD): do not edit by hand on shared hosts.
#   Committed: deployments/env/mfgcidashboard.<tier>.env
#   Install:   deployments/scripts/Install-ProjectEnv.ps1 -Environment dev|tst|prd
#   Guide:     deployments/DEPLOY.md · docs/project-files/system/org-deployment-profile.md
#
# LOCAL DATABASE — pick ONE approach (see deployments/env/local-dev-*.env.example):
#   • Not using Microsoft SQL Server on your laptop? Use SQLite (simplest) or PostgreSQL.
#   • Connecting laptop → shared DEV SQL Server? use local-dev-sql.env.example
# Deployed DEV/TST/PRD remain SQL Server in deployments/env/mfgcidashboard.<tier>.env
# =============================================================================

# --- Application (FILL) ---
APP_ENV=local
APP_NAME=MFGCIDashboard
APP_HOST=127.0.0.1
APP_PORT=8080

# --- Local database (FILL — choose engine for laptop dev) ---
# APP_DB_ENGINE: sqlite | postgresql | mssql
# If vision says no local SQL Server → prefer sqlite or postgresql (see examples below).

APP_DB_ENGINE=mssql

# Option A — SQLite (recommended when not using SQL Server locally)
#   Copy deployments/env/local-dev-sqlite.env.example into .env.local
# APP_DB_ENGINE=sqlite
# APP_DB_URL=sqlite:///./data/mfgcidashboard_local.db

# Option B — PostgreSQL (local Docker/native; pip install -e ".[dev,local-postgres]")
#   Copy deployments/env/local-dev-postgres.env.example into .env.local
# APP_DB_ENGINE=postgresql
# APP_DB_URL=postgresql+psycopg://postgres:dev@127.0.0.1:5432/mfgcidashboard_local

# Option C — Microsoft SQL Server (remote DEV or local MSSQL instance)
#   Copy deployments/env/local-dev-sql.env.example when using shared DEV SQL
APP_DB_HOST=SRVIRQSQLDEV
APP_DB_PORT=1433
APP_DB_DOMAIN=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_NAME=CIDashboard

# Built from APP_DB_* when empty (mssql) or set directly for sqlite/postgresql
APP_DB_URL=
WAREHOUSE_DB_URL=

# --- Auth (optional — dev bypass / LDAP per project) ---
# APP_AUTH_DEV_USER=
# APP_AUTH_DEV_BYPASS=true

# --- Integrations (OPTIONAL — delete block if unused) ---

# ClickUp — skip entire block if project does not use ClickUp
# CLICKUP_API_TOKEN=
# CLICKUP_WORKSPACE_ID=
# CLICKUP_BUG_LIST_ID=
# CLICKUP_BUG_LIST_NAME=
# CLICKUP_POLL_ENABLED=false

# OpenAI — skip if unused
# OPENAI_API_KEY=

# --- GitLab (optional — CI, API scripts; token is secret → .env.local only) ---
GITLAB_URL=https://srvirqisgitlab1.rossvideo.com/
GITLAB_PROJECT_ID=
GITLAB_PROJECT_PATH=manufacturing-data-infrastructure-and-applications/mfgcidashboard
GITLAB_TOKEN=
